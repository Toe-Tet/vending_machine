# Copy to .env for local development. Never commit .env.
# Real environment variables always override values here.

# local | testing | production
APP_ENV=local
APP_URL=http://localhost:8080

# docker compose overrides DB_HOST/DB_PORT for the app container (db:3306).
# From the host, MySQL is published on 127.0.0.1:3307.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=vending_machine
# The app's own MySQL user; must not be root (the MySQL image refuses MYSQL_USER=root).
DB_USER=vending_user
DB_PASSWORD=password
# Local MySQL root password (compose only; the app never uses it).
DB_ROOT_PASSWORD=root_password
# MySQL reads these only when its volume is first created: after changing them,
# run `docker compose down -v && docker compose up -d`.

# Optional: path to (or PEM contents of) the CA certificate for TLS to MySQL, e.g. Aiven.
DB_SSL_CA=

# Any non-empty value locally; production requires at least 32 characters.
JWT_SECRET=local-dev-secret-change-me
