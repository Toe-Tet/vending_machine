{
    "name": "toetet/vending-machine",
    "description": "Vending machine web app and JSON API in plain PHP.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-bcmath": "*",
        "ext-pdo_mysql": "*",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
