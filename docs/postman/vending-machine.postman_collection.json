{
  "info": {
    "name": "Vending Machine API",
    "description": "JSON API for the Vending Machine (docs/spec.md §6).\n\nRun the whole collection top to bottom (Collection Runner) against a freshly seeded app: it signs in, creates its own Product, buys from it, triggers each error, then archives the Product. Set `baseUrl` to your deployment to use it elsewhere.\n\nErrors always have the shape `{\"error\": {\"code\", \"message\", \"fields\"}}`. Tokens last one hour; re-run the Auth requests when they expire.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "description": "Exchange an email and password for a one-hour Bearer token. Run both logins first: they store `userToken` and `adminToken` in the collection variables.",
      "item": [
        {
          "name": "Login as User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Returns a token, its expiry and the user\", () => { pm.expect(json.token).to.be.a(\"string\"); pm.expect(json.expires_at).to.be.a(\"string\"); pm.expect(json.user.role).to.eql(\"user\"); });",
                  "pm.collectionVariables.set(\"userToken\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"User is an Admin\", () => pm.expect(json.user.role).to.eql(\"admin\"));",
                  "pm.collectionVariables.set(\"adminToken\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with a wrong password → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Error code is invalid_credentials\", () => pm.expect(pm.response.json().error.code).to.eql(\"invalid_credentials\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with missing fields → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Error code is validation_failed\", () => pm.expect(pm.response.json().error.code).to.eql(\"validation_failed\"));",
                  "pm.test(\"A message per field\", () => pm.expect(pm.response.json().error.fields).to.have.keys(\"email\", \"password\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products (public)",
      "description": "No token needed. Prices are strings with three decimals.",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Has data and page meta\", () => pm.expect(json.meta).to.have.keys(\"page\", \"per_page\", \"total\", \"last_page\"));",
                  "pm.test(\"Prices are strings\", () => json.data.forEach(p => pm.expect(p.price).to.be.a(\"string\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "List products sorted by price, descending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?sort=price&dir=desc&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "price"
                },
                {
                  "key": "dir",
                  "value": "desc"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "`sort`: name | price | quantity. `dir`: asc | desc. `page` ≥ 1. Unknown values fall back to name / asc / 1; pages past the end clamp to the last page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Show a product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{seededProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{seededProductId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has a Product\", () => pm.expect(pm.response.json().data).to.have.keys(\"id\", \"name\", \"price\", \"quantity_available\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Show a missing product → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "999999"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is not_found\", () => pm.expect(pm.response.json().error.code).to.eql(\"not_found\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products (Admin)",
      "description": "Needs an Admin token (`adminToken`). Creates the Product the rest of the collection uses (`productId`).",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create a product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tea\",\n  \"price\": \"2.750\",\n  \"quantity_available\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Location points at the new Product\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(`/api/products/${json.data.id}`));",
                  "pm.test(\"Price comes back as a string\", () => pm.expect(json.data.price).to.eql(\"2.750\"));",
                  "pm.collectionVariables.set(\"productId\", json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create an invalid product → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
