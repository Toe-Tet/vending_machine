    },
    {
      "name": "Purchases",
      "description": "Needs a User or Admin token. Buys from the Product created above (Quantity Available 5).",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{userToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Buy 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}/purchase",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}",
                "purchase"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const purchase = pm.response.json().data;",
                  "pm.test(\"Records the Purchase Total exactly\", () => { pm.expect(purchase.unit_price).to.eql(\"3.500\"); pm.expect(purchase.total).to.eql(\"7.000\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Buy quantity 0 → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
