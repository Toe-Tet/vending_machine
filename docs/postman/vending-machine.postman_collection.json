              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}",
                "purchase"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
