                  "pm.test(\"Error code is validation_failed\", () => pm.expect(pm.response.json().error.code).to.eql(\"validation_failed\"));",
                  "pm.test(\"Explains the quantity\", () => pm.expect(pm.response.json().error.fields.quantity).to.eql(\"Quantity must be at least 1.\"));"
                ]
